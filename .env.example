# Copy to .env.local and fill in. Only EXPO_PUBLIC_* values reach the app, and they are public by design.
# Leave SUPABASE values empty to run the app on built-in demo data.

EXPO_PUBLIC_SUPABASE_URL=
# The publishable anon key. Safe in the client because every table is protected by RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where invitation links point. The same Expo app is exported to web and hosted here.
EXPO_PUBLIC_WEB_URL=https://nordlysplanlegger.vercel.app

# From `npx eas-cli init`. Required for Expo push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Force demo data even when Supabase is configured (1 = on).
EXPO_PUBLIC_DEMO_MODE=

# NEVER put the service role key or any other secret here. Those belong in
# `supabase secrets set` for Edge Functions.
